# Copy to .env and fill in.  cp .env.example .env

# Strong random password:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Public address. On Oracle use your IP with dashes + sslip.io for free HTTPS:
#   SITE_ADDRESS=140-238-1-2.sslip.io
# Local testing without HTTPS:
SITE_ADDRESS=:80

# Dashboard login (Basic Auth). Generate the hash:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# IMPORTANT: in this file every $ in the hash must be doubled ($$), e.g. $$2a$$14$$...
BASIC_AUTH_USER=shlomo
BASIC_AUTH_HASH=

# Collector
COLLECT_INTERVAL_MIN=15
SNAPSHOT_MIN_LIQUIDITY=1000
RESEARCH_HOUR_UTC=3

# Backfill (historical research)
BACKFILL_SINCE=2024-01-01
BACKFILL_MIN_VOLUME=10000
BACKFILL_FIDELITY_MIN=360

# Research cost assumptions
RESEARCH_SLIPPAGE=0.01
RESEARCH_FEE=0.0

# Tip tracker (optional). Create at https://my.telegram.org -> API development tools. Keep secret.
TG_API_ID=
TG_API_HASH=
# comma-separated group titles or numeric ids to read (see: --list-chats)
TG_CHATS=
# Alerts (problems, recoveries, passed gates) go to your Telegram "Saved Messages" via the same session. 0 = off
ALERTS=1
# Morning summary to Saved Messages at this hour (Israel time); -1 = off. SITE_URL is added as a link
DIGEST_HOUR=8
SITE_URL=

# Crypto lab: round-trip cost charged on every simulated trade (0.01 = 1%; an Israeli app's spread is often more)
CRYPTO_COST_RT=0.01

# SEC asks automated clients to identify themselves with a contact (name + email)
SEC_USER_AGENT=

# Off-site encrypted backups (scripts/install-offsite-backup.sh). Oracle Object Storage pre-authenticated
# request URL (bucket, read+write, ends with /o/). BACKUP_KEY is generated by the install script.
OFFSITE_PAR_URL=
BACKUP_KEY=
